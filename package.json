{
  "name": "zentat",
  "description": "Convert fiat prices to ZEC inline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "node scripts/verify-nym-wasm.mjs && wxt build",
    "build:firefox": "node scripts/verify-nym-wasm.mjs && wxt build -b firefox",
    "zip": "wxt clean && wxt zip",
    "zip:firefox": "wxt clean && wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "test": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "clean": "wxt clean",
    "verify:nym": "node scripts/verify-nym-wasm.mjs"
  },
  "dependencies": {
    "@nymproject/mix-fetch": "1.4.4",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/chrome": "^0.2.7",
    "@types/webextension-polyfill": "^0.12.1",
    "dprint": "^0.56.1",
    "happy-dom": "^20.11.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4",
    "wxt": "^0.20.13"
  }
}
