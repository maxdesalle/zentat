LocaleTest
├── inferCurrencyFromHostname
│   ├── given a single-part country TLD
│   │   └── it maps every supported country ending
│   ├── given a multi-part hostname ending in a country TLD
│   │   └── it reads the country from the final ending
│   ├── given a TLD it does not know
│   │   └── it returns null for unknown TLDs
│   └── given a bare country ending
│       └── it returns null
├── AMBIGUOUS_SYMBOLS
│   └── given symbols shared by several currencies
│       └── it lists every fallback currency in order
└── resolveAmbiguousSymbol
    ├── given a dollar sign
    │   └── it resolves $ by TLD
    ├── given a yen sign
    │   └── it resolves ¥ by TLD and page language
    └── given a symbol that means one thing
        └── it returns null for unambiguous symbols
